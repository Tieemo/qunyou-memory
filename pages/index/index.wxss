.index-page {
  padding: 40rpx 32rpx 60rpx;
  align-items: center;
}

/* ---------- 头部 ---------- */
.hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.hero-cards {
  position: relative;
  width: 420rpx;
  height: 300rpx;
  margin-bottom: 8rpx;
}
.hero-card {
  position: absolute;
  width: 190rpx;
  height: 285rpx;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.55);
}
.hc-back {
  left: 0;
  top: 8rpx;
  transform: rotate(-14deg);
}
.hc-face {
  left: 115rpx;
  top: 0;
  transform: rotate(0deg);
  z-index: 2;
}
.hc-trap {
  right: 0;
  top: 8rpx;
  transform: rotate(14deg);
}
.title {
  font-size: 64rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  background: linear-gradient(135deg, #e9d5ff, #b47aff 55%, #7ddb52);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9c8fc0;
  letter-spacing: 6rpx;
}

/* ---------- 最高分 ---------- */
.best-panel {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 30rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(180, 122, 255, 0.16), rgba(125, 219, 82, 0.1));
  border: 1rpx solid rgba(180, 122, 255, 0.35);
  margin-bottom: 34rpx;
}
.best-label {
  font-size: 26rpx;
  color: #b8aed6;
}
.best-score {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffd766;
}
.best-score.neg {
  color: #ff6b81;
}

/* ---------- 难度 ---------- */
.section-title {
  align-self: flex-start;
  font-size: 30rpx;
  font-weight: 700;
  color: #d9ccf5;
  margin-bottom: 16rpx;
}
.diff-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 30rpx;
}
.diff-item {
  width: 100%;
  box-sizing: border-box;
  padding: 26rpx 30rpx;
  border-radius: 20rpx;
  background: #1d1730;
  border: 1rpx solid #322654;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.diff-item:active {
  border-color: #b47aff;
}
.diff-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.diff-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #f0eaff;
}
.diff-desc {
  font-size: 24rpx;
  color: #9c8fc0;
}
.diff-trap {
  font-size: 22rpx;
  color: #b47aff;
}

/* ---------- 图鉴入口 ---------- */
.collection-btn {
  width: 100%;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: #14230f;
  background: linear-gradient(135deg, #a5ef83, #58c945);
  box-shadow: 0 8rpx 24rpx rgba(125, 219, 82, 0.35);
  margin-bottom: 40rpx;
}

/* ---------- 规则 ---------- */
.rules {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: rgba(29, 23, 48, 0.7);
  border: 1rpx dashed #3d2f63;
}
.rules-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #b47aff;
  margin-bottom: 12rpx;
}
.rule-line {
  font-size: 23rpx;
  color: #9c8fc0;
  line-height: 1.8;
}
